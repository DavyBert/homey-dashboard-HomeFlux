{
  "id": "com.dashboard.homeflux",
  "version": "1.0.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "name": {
    "en": "HomeFlux",
    "nl": "HomeFlux",
    "de": "HomeFlux",
    "fr": "HomeFlux",
    "es": "HomeFlux"
  },
  "description": {
    "en": "See where your energy goes.",
    "nl": "Zie waar je energie naartoe gaat.",
    "de": "Sieh, wohin deine Energie fließt.",
    "fr": "Voyez où va votre énergie.",
    "es": "Descubre adónde va tu energía."
  },
  "permissions": [
    "homey:manager:api",
    "homey:app:com.athom.gallery"
  ],
  "api": {
    "listSources": {
      "method": "GET",
      "path": "/sources"
    },
    "getSelection": {
      "method": "GET",
      "path": "/selection"
    },
    "saveSelection": {
      "method": "PUT",
      "path": "/selection"
    },
    "getConfig": {
      "method": "GET",
      "path": "/config"
    },
    "saveConfig": {
      "method": "PUT",
      "path": "/config"
    },
    "testConnection": {
      "method": "POST",
      "path": "/test"
    },
    "getFlowStatus": {
      "method": "GET",
      "path": "/flow-status"
    },
    "getWeatherMappings": {
      "method": "GET",
      "path": "/weather-mapping"
    },
    "saveWeatherMapping": {
      "method": "PUT",
      "path": "/weather-mapping"
    },
    "getOwnPhotos": {
      "method": "GET",
      "path": "/photos"
    },
    "saveOwnPhoto": {
      "method": "PUT",
      "path": "/photo-mapping"
    }
  },
  "author": {
    "name": "Davy Bert"
  },
  "category": "energy",
  "brandColor": "#4F8A10",
  "tags": {
    "en": [
      "energy",
      "dashboard",
