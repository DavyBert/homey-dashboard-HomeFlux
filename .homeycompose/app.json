{
  "id": "com.dashboard.homeflux",
  "version": "0.9.4",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "name": {
    "en": "HomeFlux",
    "nl": "HomeFlux"
  },
  "description": {
    "en": "See where your energy goes.",
    "nl": "Zie waar je energie naartoe gaat."
  },
  "permissions": [
    "homey:manager:api",
    "homey:app:com.athom.gallery"
  ],
  "api": {
    "listSources": {
      "method": "GET",
      "path": "/sources"
    },
    "getSelection": {
      "method": "GET",
      "path": "/selection"
    },
    "saveSelection": {
      "method": "PUT",
      "path": "/selection"
    },
    "getConfig": {
      "method": "GET",
      "path": "/config"
    },
    "saveConfig": {
      "method": "PUT",
      "path": "/config"
    },
    "testConnection": {
      "method": "POST",
      "path": "/test"
    },
    "getFlowStatus": {
      "method": "GET",
      "path": "/flow-status"
    },
    "getWeatherMappings": {
      "method": "GET",
      "path": "/weather-mapping"
    },
    "saveWeatherMapping": {
      "method": "PUT",
      "path": "/weather-mapping"
    },
    "getOwnPhotos": {
      "method": "GET",
      "path": "/photos"
    },
    "saveOwnPhoto": {
      "method": "PUT",
      "path": "/photo-mapping"
    }
  },
  "author": {
    "name": "Davy Bert"
  },
  "category": "energy",
  "brandColor": "#4F8A10",
  "tags": {
    "en": [
      "energy",
      "dashboard",
      "solar",
      "battery",
      "ev",
      "widget",
      "widgets"
    ],
    "nl": [
      "energie",
      "dashboard",
      "zonnepanelen",
      "batterij",
      "autolader",
      "widget",
      "widgets"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "support": "https://github.com/DavyBert/homey-dashboard-HomeFlux/issues",
  "bugs": {
    "url": "https://github.com/DavyBert/homey-dashboard-HomeFlux/issues"
  },
  "source": "https://github.com/DavyBert/homey-dashboard-HomeFlux",
  "homepage": "https://github.com/DavyBert/homey-dashboard-HomeFlux"
}
